{
  "name": "@gullabs/drizzle",
  "version": "0.3.8",
  "description": "Drizzle ORM companion for any-llm — reference llm_calls schema and UsageSink for Postgres.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gullabs/any-llm.git",
    "directory": "packages/drizzle"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@gullabs/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "drizzle-orm": "^0.45.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gullabs/any-llm/tree/main/packages/drizzle#readme",
  "bugs": "https://github.com/gullabs/any-llm/issues"
}
