{
  "name": "@gullabs/core",
  "version": "0.2.0",
  "description": "Provider-agnostic LLM engine: types, ports, cost computation, and the call pipeline. No provider dependencies.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gullabs/any-llm.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4"
  },
  "devDependencies": {
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gullabs/any-llm/tree/main/packages/core#readme",
  "bugs": "https://github.com/gullabs/any-llm/issues"
}
