{
  "name": "anyllm-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist",
    "example": "tsx examples/basic.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@gullabs/core": "workspace:*",
    "@gullabs/google": "workspace:*",
    "@gullabs/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "packageManager": "pnpm@9.12.0"
}
