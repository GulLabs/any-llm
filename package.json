{
  "name": "anyllm-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "pnpm -r build && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "pnpm -r exec rm -rf dist",
    "example": "tsx examples/basic.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@gullabs/any-llm": "workspace:*",
    "@gullabs/core": "workspace:*",
    "@gullabs/google": "workspace:*",
    "@gullabs/testing": "workspace:*",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.6.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "human-id": "4.1.3",
      "vite": "7.3.6",
      "esbuild": ">=0.28.1",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.17",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9"
    }
  }
}
